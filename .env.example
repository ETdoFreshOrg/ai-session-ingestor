# Memory Database API (required for non-dry-run syncs)
MEMORY_DATABASE_API_URL=http://localhost:3000
MEMORY_DATABASE_API_WRITE_TOKEN=

# Human display name used for user messages
SENDER_NAME=ET

# Optional source roots (defaults shown)
CLAUDE_DATA_DIR=~/.claude
CODEX_DATA_DIR=~/.codex
OPENCODE_DATA_DIR=~/.local/share/opencode
ANTIGRAVITY_DATA_DIR=~/.gemini/antigravity-cli
PI_DATA_DIR=~/.pi/agent
ETBOT_DATA_DIR=~/.local/share/etbot
# ETBOT_DB_PATH=/sources/etbot/etbot/etbot.sqlite

# ETBot: skip (default) or include messages imported from Duet (already archived as anthropic)
ETBOT_IMPORTED=skip
# ETBot computer command output as tool_output records: on (default) or off
ETBOT_TOOL_EVENTS=on

# Claude Code tool call/result records: new (default), all, off, or an ISO date
CLAUDECODE_TOOL_EVENTS=new

# Service settings
PORT=3460
HOST=0.0.0.0
AUTO_SYNC=false
SYNC_INTERVAL_MS=900000
WRITE_CONCURRENCY=2
API_TIMEOUT_MS=30000
DATA_DIR=.data
# Host name for freshness keys when os.hostname() is a container ID
# INGESTOR_HOSTNAME=

# Optional Bearer token for POST /api/sync
INGESTOR_API_TOKEN=
