{
  "name": "ai-session-ingestor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified Claude Code, Codex, OpenCode, Antigravity, Pi, and ETBot session ingestor for Memory Database",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:cloud": "node dist/cloud-server.js",
    "server": "tsx src/server.ts",
    "sync": "tsx src/cli.ts",
    "test": "vitest run && python3 test/imessage_test.py",
    "test:watch": "vitest",
    "test:ts": "vitest run",
    "test:python": "python3 test/imessage_test.py",
    "migrate:oversized": "tsx scripts/migrate-oversized-records.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
